+// Host controls preserve the physical USB/BT/2.4G slider as the routing owner.
+uint8_t openkeyboard_wireless_profile(void) {
+    return wireless_mode == WL_MODE_24G ? 0 : (uint8_t)last_bt_profile - 0x30;
+}
+bool openkeyboard_set_wireless_profile(uint8_t value) {
+    if (value < 1 || value > 3 || wireless_mode == WL_MODE_24G) return false;
+    save_bt_profile((ch582_profile_t)(0x30 + value));
+    if (wireless_mode == WL_MODE_BT) ch582_set_profile(last_bt_profile);
+    return true;
+}
